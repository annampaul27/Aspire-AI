# ==============================================================================
# Aspire AI — Example Environment Configuration (.env.example)
# Copy this file to '.env' at the repository root and customize for your environment:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Platform Configuration
# ------------------------------------------------------------------------------
PROJECT_NAME="Aspire AI Engine"
VERSION="2.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# ------------------------------------------------------------------------------
# Security & Cryptography (JWT & RBAC)
# ------------------------------------------------------------------------------
# Generate a cryptographically secure random key for production:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY="aspireai-deterministic-sha256-jwt-secret-key-super-secure-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# AI & LLM Services (Groq Cloud & Google Gemini)
# ------------------------------------------------------------------------------
# Obtain your Groq Cloud API Key at https://console.groq.com/keys
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="llama-3.3-70b-versatile"

# Optional: Google Gemini API Key from https://aistudio.google.com
GEMINI_API_KEY="your_gemini_api_key_here"

# Vector Store (ChromaDB) Path & Offline Heuristics Fallback
CHROMA_DB_PATH="./chroma_db"
USE_OFFLINE_CACHE=true

# ------------------------------------------------------------------------------
# Database & Persistence (SQLAlchemy 2.0 & Alembic)
# ------------------------------------------------------------------------------
# Leave blank for zero-friction local development (automatically defaults to SQLite: backend/app/db/aspire.db)
# Or configure a PostgreSQL URI for staging / production:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aspire"
DATABASE_URL=""

# ------------------------------------------------------------------------------
# SaaS Billing & Dual Payment Gateways (Razorpay & Stripe)
# ------------------------------------------------------------------------------
# Stripe API Credentials (USD / Global B2B) - https://dashboard.stripe.com/apikeys
STRIPE_API_KEY=""
STRIPE_WEBHOOK_SECRET="whsec_aspire_test_secret_2026"

# Razorpay API Credentials (INR / Domestic) - https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID="rzp_test_aspire_2026"
RAZORPAY_KEY_SECRET="rzp_test_secret_aspire_2026"
RAZORPAY_WEBHOOK_SECRET="rzp_webhook_secret_2026"

# ------------------------------------------------------------------------------
# GitHub Integration & Portfolio Analysis
# ------------------------------------------------------------------------------
# Personal Access Token with public_repo read access for Candidate Talent Radar
GITHUB_PAT=""

# ------------------------------------------------------------------------------
# Autonomous Multimodal AI Interview Coach Microservice
# ------------------------------------------------------------------------------
INTERVIEW_HOST="0.0.0.0"
INTERVIEW_PORT=8005
WHISPER_MODEL="whisper-large-v3-turbo"

# ------------------------------------------------------------------------------
# Frontend Client Environment Variables (Next.js 16 App Router)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
NEXT_PUBLIC_SERVER_URL="http://localhost:8000"
NEXT_PUBLIC_WS_URL="localhost:8000"
